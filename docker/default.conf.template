# envsubst 로 ${NGINX_PORT}, ${APP_ENV} 가 치환된 뒤 /etc/nginx/conf.d/default.conf 로 배치된다.
# nginx 공식 엔트리포인트(20-envsubst-on-templates.sh)는 "실제로 정의된 환경변수 이름"만
# envsubst 에 넘기므로, 아래 $uri 같은 nginx 런타임 변수는 치환되지 않고 그대로 보존된다.
server {
    listen       ${NGINX_PORT};
    server_name  localhost;

    root  /usr/share/nginx/html;
    index index.html;

    # 헬스체크 엔드포인트: 환경변수가 실제로 주입됐는지 눈으로 확인하는 용도도 겸한다.
    location = /health {
        add_header Content-Type text/plain;
        return 200 "ok env=${APP_ENV} port=${NGINX_PORT}\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
