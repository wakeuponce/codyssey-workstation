?? Dockerfile
?? README.md
?? app/
?? docker-compose.yml
?? docker/
?? docs/
?? logs/
?? scripts/

# 현재 브랜치를 main 으로 맞춘다 (git init 이 이전 설정으로 만들어졌을 수 있음).

$ git branch -M main

# 커밋 대상에서 제외되는 규칙

$ cat .gitignore
# OS
.DS_Store
Thumbs.db
desktop.ini

# 편집기 / 도구
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# 비밀정보 - 절대 커밋 금지
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
*_token*
credentials*

# 실제로 무시되고 있는 파일이 있는지 확인

$ git status --ignored --short | grep '^!!' || echo '(무시된 파일 없음)'
(무시된 파일 없음)


