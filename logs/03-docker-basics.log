# $(whoami) 는 컨테이너 안에서 확장돼야 한다. 작은따옴표로 감싸 호스트 셸의 조기 확장을 막는다.

$ docker exec ubuntu-lab sh -c 'echo "컨테이너 내부 사용자: $(whoami)" && head -2 /etc/os-release'
컨테이너 내부 사용자: root
PRETTY_NAME="Ubuntu 24.04.4 LTS"
NAME="Ubuntu"

# 컨테이너 내부에 파일을 만들어 본다 (이 데이터는 컨테이너를 지우면 사라진다 - 05 에서 볼륨으로 해결).

$ docker exec ubuntu-lab bash -c "echo 'ephemeral data' > /tmp/tmp.txt && cat /tmp/tmp.txt"
ephemeral data

# exec 로 띄운 프로세스가 끝나도 컨테이너는 그대로 Up 상태다.

$ docker ps --filter name=ubuntu-lab --format 'table {{.Names}}\t{{.Status}}'
NAMES        STATUS
ubuntu-lab   Up 1 second


########## 5. attach vs exec 차이 관찰 ##########

# exec  : 컨테이너 안에 '새 프로세스'를 추가로 띄운다. 빠져나와도 컨테이너는 계속 산다.

# attach: 이미 돌고 있는 PID 1 의 입출력에 '연결'한다. PID 1 을 끝내면 컨테이너도 끝난다.

# 아래에서 attach 로 PID 1 인 bash 에 'exit' 를 흘려보내 컨테이너가 죽는지 확인한다.

# [attach 전] 컨테이너는 Up 상태다.

$ docker ps --filter name=ubuntu-lab --format '{{.Names}} -> {{.Status}}'
ubuntu-lab -> Up 1 second

# PID 1 인 bash 의 stdin 으로 'exit' 를 흘려보낸다.

$ echo exit | docker attach ubuntu-lab

# [attach 후] PID 1 이 스스로 종료했으므로 컨테이너도 Exited (0) 이 된다.

# 반면 4번의 exec 는 아무리 빠져나와도 컨테이너 상태를 바꾸지 못했다. 이것이 둘의 결정적 차이다.

$ docker ps --filter name=ubuntu-lab --format '{{.Names}} -> {{.Status}}'

$ docker ps -a --filter name=ubuntu-lab --format 'table {{.Names}}\t{{.Status}}'
NAMES        STATUS
ubuntu-lab   Exited (0) Less than a second ago

# 중지된 컨테이너는 start 로 다시 살릴 수 있다 (컨테이너는 삭제 전까지 상태가 보존된다).

$ docker start ubuntu-lab
ubuntu-lab

$ docker ps --filter name=ubuntu-lab --format '{{.Names}} -> {{.Status}}'
ubuntu-lab -> Up Less than a second

# 아까 exec 로 만든 /tmp/tmp.txt 가 남아있다. '컨테이너 재시작'과 '컨테이너 삭제'는 다르다.

$ docker exec ubuntu-lab cat /tmp/tmp.txt
ephemeral data

$ docker stop ubuntu-lab
ubuntu-lab

$ docker ps -a --filter name=ubuntu-lab --format 'table {{.Names}}\t{{.Status}}'
NAMES        STATUS
ubuntu-lab   Exited (137) Less than a second ago


########## 6. 운영 명령 - logs ##########

# 컨테이너의 표준출력/표준에러가 곧 로그다. 애플리케이션이 파일 대신 stdout 으로 찍어야 하는 이유.

$ docker run -d --name ticker ubuntu:24.04 bash -c 'for i in 1 2 3 4 5; do echo "tick $i"; sleep 1; done'
9f3df722e38301c21d36fd816dde794a45513d0700c0c090d7c99618bea7cf30

$ sleep 6

$ docker logs ticker
tick 1
tick 2
tick 3
tick 4
tick 5

# -t 를 붙이면 타임스탬프가 함께 나온다.

$ docker logs -t ticker | tail -3
2026-07-29T07:33:08.238531806Z tick 3
2026-07-29T07:33:09.241049292Z tick 4
2026-07-29T07:33:10.244312477Z tick 5


########## 7. 운영 명령 - stats (리소스 사용량) ##########

# stats 는 기본이 실시간 스트리밍이므로, 로그로 남기려면 --no-stream 을 쓴다.

$ docker run -d --name ubuntu-idle ubuntu:24.04 sleep 120
c94c92401189aa5fc3ae8108abfebb31f3be9c8a688030edb51f3203b75c263c

$ docker stats --no-stream
CONTAINER ID   NAME                CPU %     MEM USAGE / LIMIT     MEM %     NET I/O           BLOCK I/O         PIDS
c94c92401189   ubuntu-idle         0.00%     1.047MiB / 15.41GiB   0.01%     516B / 126B       0B / 0B           1
ab047e18bf2a   codyssey-web-8081   0.00%     19.25MiB / 15.41GiB   0.12%     3.83kB / 2.97kB   0B / 16.4kB       23
91334a6934ab   codyssey-web-8080   0.00%     22.52MiB / 15.41GiB   0.14%     5.79kB / 6.85kB   15.1MB / 16.4kB   23


